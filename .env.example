# ===== 令牌配置（两种方式任选其一）=====
# 方式一（推荐）：不填环境变量，直接运行 .venv/bin/python login.py all
#   会弹出浏览器窗口扫码/账号登录，自动捕获令牌并保存到 session/ 目录，
#   网关启动时自动读取；令牌过期后网关启动时会尝试静默刷新。
#
# 方式二（手动，可选）：从浏览器 DevTools 复制令牌填到下面，覆盖 session/。
#   - 通义千问: 登录 tongyi.aliyun.com/qianwen -> F12 -> Application -> Cookies
#     找到 tongyi_sso_ticket 的值（若 >100 字符则为 login_aliyunid_ticket）
#   - DeepSeek: 登录 chat.deepseek.com -> F12 -> Network -> 发消息 ->
#     chat/completion 请求的 Authorization Bearer token
QWEN_AUTH_TOKEN=
QWEN_COOKIE=
DEEPSEEK_AUTH_TOKEN=
DEEPSEEK_COOKIE=

# ===== 服务配置 =====
HOST=127.0.0.1
PORT=8000
TIMEOUT=600
